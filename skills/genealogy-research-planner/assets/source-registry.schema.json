{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source registry for one country",
  "description": "Which record types each source holds, for which places and years, how to reach it and what it costs. scripts/gap_finder.py reads these files; references/source-registry.md explains the fields.",
  "type": "object",
  "required": ["schema_version", "code", "name", "place_names", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "code": {"type": "string", "minLength": 2},
    "name": {"type": "string", "minLength": 1},
    "note": {"type": "string"},
    "place_names": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "year": {"type": ["integer", "null"]},
    "record_types": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["birth", "baptism", "marriage", "death", "burial", "census", "foundling", "newspaper", "probate", "military", "migration", "other"]}
    },
    "places": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "coverage": {
      "type": "object", "required": ["from_year", "to_year", "places"], "additionalProperties": false,
      "properties": {
        "from_year": {"$ref": "#/$defs/year"}, "to_year": {"$ref": "#/$defs/year"},
        "places": {"$ref": "#/$defs/places"}, "record_types": {"$ref": "#/$defs/record_types"},
        "note": {"type": "string"}
      }
    },
    "gap": {
      "type": "object", "required": ["record_types", "places", "from_year", "to_year", "note"], "additionalProperties": false,
      "properties": {
        "record_types": {"$ref": "#/$defs/record_types"}, "places": {"$ref": "#/$defs/places"},
        "from_year": {"$ref": "#/$defs/year"}, "to_year": {"$ref": "#/$defs/year"},
        "note": {"type": "string", "minLength": 1},
        "learned_from": {"type": "string", "minLength": 1}, "learned_on": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object", "required": ["id", "name", "record_types", "coverage", "access", "query"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "record_types": {"$ref": "#/$defs/record_types"},
        "coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/coverage"}},
        "access": {
          "type": "object", "required": ["route", "cost"], "additionalProperties": false,
          "properties": {
            "route": {"enum": ["online_images", "online_index", "catalogue_only", "request", "onsite"]},
            "cost": {"enum": ["free", "account", "paid"]},
            "note": {"type": "string"}
          }
        },
        "query": {
          "type": "object", "required": ["method", "how"], "additionalProperties": false,
          "properties": {
            "method": {"enum": ["catalogue_search", "index_search", "browse_by_book", "order_certificate", "onsite_visit", "write_to_custodian"]},
            "how": {"type": "string", "minLength": 1}
          }
        },
        "verification": {"type": "object"},
        "known_gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
      }
    }
  }
}
