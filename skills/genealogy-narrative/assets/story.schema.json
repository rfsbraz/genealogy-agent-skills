{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "story_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "person_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_digest": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "documentary",
        "evocative",
        "novelized"
      ]
    },
    "visibility": {
      "const": "private"
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "intro_note": {
      "type": "string",
      "minLength": 1
    },
    "fiction_notice": {
      "type": "string"
    },
    "context_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "citation": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "consulted_on": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "citation",
          "locator",
          "consulted_on",
          "scope"
        ],
        "additionalProperties": false
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "documented",
              "recollection",
              "inference",
              "context",
              "imagined"
            ]
          },
          "basis": {
            "enum": [
              "record_statement",
              "reviewed_conclusion",
              "attributed_memory",
              "reasoned_inference",
              "historical_context",
              "fiction"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "observation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "conclusion_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "context_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "basis",
          "text",
          "observation_ids",
          "conclusion_ids",
          "context_ids",
          "note"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "story_id",
    "case_id",
    "person_id",
    "evidence_digest",
    "mode",
    "visibility",
    "language",
    "title",
    "intro_note",
    "fiction_notice",
    "context_sources",
    "blocks",
    "unresolved"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private genealogy narrative with passage-level provenance"
}
